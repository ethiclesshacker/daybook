{
  "name": "finance-hub",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test 'test/*.test.js'",
    "lint": "eslint .",
    "typecheck": "tsc -p .",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "deploy": "npm run check && wrangler pages deploy dist --project-name finance --branch main",
    "deploy:preview": "npm run check && wrangler pages deploy dist --project-name finance --branch preview",
    "ledger:probe": "node --env-file-if-exists=.env --env-file-if-exists=.env.ledger ledger/cli.js probe",
    "ledger:ingest": "node --env-file-if-exists=.env --env-file-if-exists=.env.ledger ledger/cli.js ingest",
    "ledger:summarize": "node --env-file-if-exists=.env --env-file-if-exists=.env.ledger ledger/cli.js summarize",
    "ledger:tool": "node --env-file-if-exists=.env --env-file-if-exists=.env.ledger ledger/cli.js tool",
    "ledger:mcp": "node --env-file-if-exists=.env --env-file-if-exists=.env.ledger ledger/mcp.js",
    "ledger:users": "node --env-file-if-exists=.env --env-file-if-exists=.env.ledger ledger/cli.js users",
    "ledger:nutrition": "node --env-file-if-exists=.env --env-file-if-exists=.env.ledger ledger/cli.js nutrition",
    "ledger:costs": "node --env-file-if-exists=.env --env-file-if-exists=.env.ledger ledger/cli.js costs",
    "ledger:purge": "node --env-file-if-exists=.env --env-file-if-exists=.env.ledger ledger/cli.js purge",
    "ledger:models": "node --env-file-if-exists=.env --env-file-if-exists=.env.ledger ledger/cli.js models",
    "ledger:reset": "node --env-file-if-exists=.env --env-file-if-exists=.env.ledger ledger/cli.js reset",
    "ledger:tools-manifest": "node --env-file-if-exists=.env --env-file-if-exists=.env.ledger ledger/cli.js tools-manifest"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.1"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@supabase/auth-js": "2.110.0",
    "@supabase/postgrest-js": "2.110.0",
    "@supabase/supabase-js": "^2.110.0",
    "chart.js": "^4.5.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "date-fns": "^4.4.0",
    "imapflow": "^1.0.194",
    "mailparser": "^3.7.4",
    "unpdf": "1.8.1"
  }
}
