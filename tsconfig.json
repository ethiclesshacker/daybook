{
  // Type-checks plain JS files that opt in with a `// @ts-check` first line
  // (`npm run typecheck`). Add the header to a file once it passes.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["node", "vite/client"],
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false
  },
  "include": ["src/**/*.js", "ledger/**/*.js", "scripts/**/*.mjs", "test/**/*.js", "supabase/functions/healthsync/validate.js"]
}
